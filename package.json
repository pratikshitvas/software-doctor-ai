{
 "name":"software-doctor-ai","version":"0.2.0","private":true,"type":"module",
 "workspaces":["apps/api","apps/web","apps/desktop","apps/mobile","packages/monitoring-sdk"],
 "scripts":{
  "dev":"concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
  "dev:api":"npm --workspace apps/api run dev",
  "dev:web":"npm --workspace apps/web run dev",
  "dev:desktop":"npm --workspace apps/desktop run dev",
  "dev:mobile":"npm --workspace apps/mobile run dev",
  "db:generate":"npm --workspace apps/api run db:generate",
  "db:migrate":"npm --workspace apps/api run db:migrate",
  "test":"npm --workspaces --if-present run test",
  "build:web":"npm --workspace apps/web run build",
  "build:desktop":"npm --workspace apps/desktop run build",
  "build:android":"npm --workspace apps/mobile run android",
  "start":"npm --workspace apps/api run start"
 },
 "devDependencies":{"concurrently":"^9.1.2"}
}